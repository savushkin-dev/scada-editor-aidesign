.venv-*/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- IDE ---
.idea/
.vscode/

# --- Крупные архивы ---
*.rar
*.zip

# --- Результаты обучения YOLO (кроме используемой модели train2/best.pt) ---
design/src/design-generation/runs/*
!design/src/design-generation/runs/detect/
design/src/design-generation/runs/detect/*
!design/src/design-generation/runs/detect/train2/
